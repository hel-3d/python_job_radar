# Telegram user API credentials for Telethon parser
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=python_job_radar

# Regular BotFather bot token for publisher
BOT_TOKEN=123456:your_bot_token

# Channel where suitable jobs will be posted. Bot must be admin there.
TARGET_CHANNEL_ID=@your_python_jobs_channel

# Only this Telegram user can run admin commands in the channel
ADMIN_USER_ID=5521667593

# Source channels separated by commas
SOURCE_CHANNELS=@nextit_backend,@YotolabBackend,@job_python,@ru_pythonjobs,@myjobit

# Minimum match score for saving a job to queue
MIN_SCORE_TO_QUEUE=45

# Publishing schedule
PUBLISH_INTERVAL_MINUTES=30
PUBLISH_TZ_OFFSET_HOURS=4
PUBLISH_FROM_HOUR=8
PUBLISH_TO_HOUR=23
