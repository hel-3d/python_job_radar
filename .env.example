# Telegram user API credentials for Telethon
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=python_job_radar

# Telegram bot
BOT_TOKEN=123456:your_bot_token
TARGET_CHANNEL_ID=@your_channel
ADMIN_USER_ID=123456789

# Source channels separated by commas
SOURCE_CHANNELS=@channel_one,@channel_two

# Vacancy filtering
MIN_SCORE_TO_QUEUE=45

# OpenAI reviewer
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Publishing schedule
PUBLISH_INTERVAL_MINUTES=30
PUBLISH_TZ_OFFSET_HOURS=4
PUBLISH_FROM_HOUR=8
PUBLISH_TO_HOUR=23

# Upwork parser
UPWORK_MIN_HOURLY_RATE=20
UPWORK_MIN_FIXED_BUDGET=200
UPWORK_MAX_PROPOSALS=20
UPWORK_PAYMENT_VERIFIED_ONLY=true
UPWORK_EXCLUDE_NO_HIRES=true
UPWORK_SEARCH_QUERIES=python automation;python scraping;fastapi;telegram bot
UPWORK_PARSER_INTERVAL_MINUTES=30